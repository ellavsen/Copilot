# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────
# From @BotFather in Telegram.
BOT_TOKEN=
# From platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Language model ────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4

# ── Storage (defaults are fine for local use) ─────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///data/indlab.db

# ── Reminders ─────────────────────────────────────────────────────────
# Days before a deadline to nudge the artist.
# REMINDER_LEAD_DAYS=30,14,7,3,1
# How often the service sweeps for due reminders, in seconds.
# REMINDER_POLL_SECONDS=900

# ── Logging ───────────────────────────────────────────────────────────
# INFO by default. DEBUG writes prompts and model output to the log —
# do not use it on a machine handling real artists' data.
LOG_LEVEL=INFO

# ── Knowledge base (optional, needs the [rag] extra) ───────────────────
# Folder scanned by `indlab-ingest` for PDF / DOCX / MD files.
# CORPUS_DIR=data/corpus
# EMBEDDING_MODEL=deepvk/USER-bge-m3

# ── Google Drive as a corpus source (optional, needs the [gdrive] extra)
# Keep the service-account key OUTSIDE this repository.
# GDRIVE_SERVICE_ACCOUNT_FILE=/absolute/path/outside/repo/service-account.json
# GDRIVE_FOLDER_IDS=folderId1,folderId2
